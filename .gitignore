*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/

# 日志
*.log

# 临时文件
*.bak
*.tmp
*.temp

# UVM/DPI specific (preserved from original)
*.o
*.a
results.xml
inc/export_dpi.h
inc/vpi_attr.h
inc/svuvm_export_dpi.svh
# setuptools_scm generated file (re-generated on every build)
src/svuvm/_version.py

# the UVM fork the verilator leg builds against; CI clones it into the root,
# and a local checkout is often a symlink, which a trailing slash would miss
uvm-verilator
# xezim coverage output
xezim_cov.json

# cocotb per-backend build products (also covered by the global build/ rule)
/test/cocotb_test/build/

# RAL generated artefacts. Path-limited so a legitimate source directory with
# one of these names elsewhere in the tree is never ignored by accident.
/test/pyral_test/gen/
/test/pyral_test/rtl/
/test/pyral_test/c_header/
/test/pyral_test/build/
/test/unicorn_test/gen/
/test/unicorn_test/rtl/
/test/unicorn_test/c_header/
/test/unicorn_test/build/
/test/renode_test/gen/
/test/renode_test/rtl/
/test/renode_test/c_header/
/test/renode_test/build/
# Cache locks/manifests written by ral_common.artifacts
/test/*/.artifact-gen.lock
/test/*/.artifact-manifest.json
